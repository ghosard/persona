[
  {
    "type": "function",
    "name": "delegate_task",
    "description": "把一件事交给这次通话绑定的对话去做（是谁见 instructions 里「绑定的对话」）：调用时立刻发出去，不复述、不等确认，所以拿不准用户是不是要它做就先问一句。调用不会马上返回：告诉用户一声交给它了，然后照常聊；它这一轮做完，这次调用的结果就是它的回答（可能要几分钟），那时再告诉用户。task 第一句就是要做的事，写成一句完整的指令（它看不到这次语音的上下文）。问它在干什么、到哪了，task 用「状态：」开头（不会发给它，结果是它现在的状态）；用户明确要它停下，用「停止：」开头；用户在回答它问的问题，用「回答：」开头。",
    "parameters": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "type": "string",
          "description": "要它做的事，完整的一句或几句话；或者「状态：」「停止：」「回答：」开头的一句"
        }
      }
    }
  }
]
